---
import { swatchVars } from "../../../components/a/color";
import Headword from "../../../components/a/Headword.astro";
import { displayGlyphs, type Entry, loadEntries, vtName } from "../../../components/a/words";
import A from "../../../layouts/A.astro";

export async function getStaticPaths() {
  const entries = await loadEntries();
  const n = entries.length;
  const glyphs = displayGlyphs(entries);
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      prev: n > 1 ? entries[(i - 1 + n) % n] : undefined,
      next: n > 1 ? entries[(i + 1) % n] : undefined,
      glyphs,
    },
  }));
}

interface Props {
  entry: Entry;
  prev?: Entry;
  next?: Entry;
  glyphs: string;
}

const { entry, prev, next, glyphs } = Astro.props;
const { word, reading, kind, meaning, origin, example, sources } = entry.data;
const base = import.meta.env.BASE_URL;
const chars = [...word].length;

// 例文の中の見出し語に印を付ける
const exampleParts = example.split(word);

const neighbors = [
  prev && { e: prev, dir: "前の語", cls: "a-nb-prev", rel: "prev" },
  // 語が二つしかないと前後が同じ語になる。view-transition-name が重複しないよう一つだけ出す
  next && next.id !== prev?.id && { e: next, dir: "次の語", cls: "a-nb-next", rel: "next" },
].filter((x) => !!x);
---

<A title={`${word}（${reading}）｜goi`} description={meaning} glyphs={glyphs} swatch={entry.swatch}
  ogImage={`${base}og/${entry.id}.png`}
>
  <main class="a-word">
    <header class="a-top">
      <p class="a-mark"><a href={`${base}a/`}>goi</a></p>
    </header>

    <div class="a-head">
      <h1 class="a-headword" style={`--n:${chars};view-transition-name:${vtName(entry.id)}`}>
        <Headword entry={entry} />
      </h1>
    </div>

    <div class="a-detail">
      <div class="a-detail-in">
        <div>
          <p class="a-kind">{kind}</p>
          <p class="a-meaning">{meaning}</p>
        </div>
        <dl class="a-facts">
          {
            example && (
              <div class="a-fact">
                <dt>例</dt>
                <dd class="a-example">
                  {exampleParts.map((part, i) => (
                    <>
                      {part}
                      {i < exampleParts.length - 1 && <b>{word}</b>}
                    </>
                  ))}
                </dd>
              </div>
            )
          }
          {
            origin && (
              <div class="a-fact">
                <dt>由来</dt>
                <dd>{origin}</dd>
              </div>
            )
          }
          <div class="a-fact">
            <dt>出典</dt>
            <dd>
              <ul class="a-sources">
                {
                  sources.map((s) => (
                    <li>
                      <a href={s.url}>{s.label}</a>
                      <span class="a-host">{new URL(s.url).hostname}</span>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    {
      neighbors.length > 0 && (
        <nav class="a-neighbors" aria-label="前後の語">
          {neighbors.map(({ e, dir, cls, rel }) => (
            <a class:list={["a-nb", cls]} href={`${base}a/w/${e.id}/`} rel={rel} style={swatchVars(e.swatch)}>
              <span class="a-nb-dir">{dir}</span>
              <span class="a-nb-word" style={`view-transition-name:${vtName(e.id)}`}>
                {e.data.word}
              </span>
            </a>
          ))}
        </nav>
      )
    }
  </main>
</A>
