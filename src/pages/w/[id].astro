---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const words = (await getCollection("words")).filter((w) => !w.data.pending);
  return words.map((w) => ({ params: { id: w.id }, props: { word: w.data } }));
}

const { word } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base title={`${word.word}（${word.reading}）｜goi`} description={word.meaning}>
  <main>
    <p><a href={base}>goi</a></p>
    <h1>{word.word}</h1>
    <p>{word.reading}</p>
    <p>{word.meaning}</p>
    <p>{word.origin}</p>
    <p>{word.example}</p>
    <ul>
      {
        word.sources.map((s) => (
          <li>
            <a href={s.url}>{s.label}</a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
