---
import { getCollection } from "astro:content";

// GitHub Pages は /goi/ 以下の存在しないパスにこのページを 404 で返す。
// 1枚しか置けないので、英語で出して /goi/ja/ の下なら日本語に切り替える
const base = import.meta.env.BASE_URL;
// 語の id と見出し。旧 URL の案内に使う
const words = Object.fromEntries(
  (await getCollection("words")).filter((w) => !w.data.pending).map((w) => [w.id, w.data.word]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex" />
    <title>Page not found | goi</title>
    <meta name="description" content="The page you were looking for could not be found." />
  </head>
  <body>
    <main data-lang="en">
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p>The URL may be wrong, or the page may have moved or been removed.</p>
      <section data-moved hidden aria-labelledby="moved-en">
        <h2 id="moved-en">This page has moved</h2>
        <p>You can read it at <a data-moved-link href={base}>the new page</a>.</p>
      </section>
      <p><a href={base} data-home>Back to the route map</a></p>
    </main>
    <main data-lang="ja" lang="ja" hidden>
      <p class="code">404</p>
      <h1>ページが見つかりません</h1>
      <p>URL が間違っているか、ページが移動・削除されたようです。</p>
      <section data-moved hidden aria-labelledby="moved-ja">
        <h2 id="moved-ja">ページは移動しました</h2>
        <p><a data-moved-link href={`${base}ja/`}>新しいページ</a>で読めます。</p>
      </section>
      <p><a href={`${base}ja/`} data-home>トップの路線図に戻る</a></p>
    </main>
    <script is:inline type="application/json" id="goi-words" set:html={JSON.stringify(words).replace(/</g, "\\u003c")} />
    <script is:inline define:vars={{ base }}>
      const ja = location.pathname.startsWith(`${base}ja/`);
      if (ja) {
        document.documentElement.lang = "ja";
        document.title = "ページが見つかりません | goi";
        document.querySelector('[data-lang="en"]').hidden = true;
        document.querySelector('[data-lang="ja"]').hidden = false;
      }
      const main = document.querySelector(`[data-lang="${ja ? "ja" : "en"}"]`);
      const prefix = ja ? `${base}ja/` : base;
      // デザインを3案出していたころの /goi/a/ /goi/b/ /goi/c/ と、その下の語のページを今の URL へ案内する
      const words = JSON.parse(document.getElementById("goi-words").textContent);
      const rest = location.pathname.slice(prefix.length);
      const m = rest.match(/^[abc]\/(?:w\/([a-z0-9-]+)\/?)?$/);
      if (m && (!m[1] || Object.hasOwn(words, m[1]))) {
        const box = main.querySelector("[data-moved]");
        const link = box.querySelector("[data-moved-link]");
        if (m[1]) {
          link.href = `${prefix}w/${m[1]}/`;
          link.textContent = ja ? `「${words[m[1]]}」のページ` : `the page for ${words[m[1]]}`;
        } else {
          link.textContent = ja ? "トップの路線図" : "the route map";
        }
        box.hidden = false;
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --fg: #1a1a1a;
    --muted: #555;
    --bg: #fff;
    --rule: #ddd;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --fg: #ececec;
      --muted: #b0b0b0;
      --bg: #151515;
      --rule: #3a3a3a;
    }
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
  }
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: 10vh 1rem 4rem;
    font-family: system-ui, "Hiragino Sans", sans-serif;
    line-height: 1.8;
  }
  .code {
    margin: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 1rem;
  }
  h2 {
    font-size: 1.125rem;
    margin: 2.5rem 0 0.5rem;
  }
  p {
    color: var(--muted);
  }
  section {
    border-block: 1px solid var(--rule);
    padding-block: 0.5rem 1rem;
    margin-block: 2rem;
  }
  ul {
    padding-left: 1.25rem;
  }
  li {
    margin-block: 0.5rem;
  }
  a {
    color: inherit;
    text-underline-offset: 0.25em;
  }
</style>
