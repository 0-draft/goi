---
import Alternates from "../components/Alternates.astro";
import LangSwitch from "../components/LangSwitch.astro";
import WebFonts from "../components/WebFonts.astro";
import { type Lang, localePath, t } from "../i18n/ui";
import "../styles/site.css";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** OGP 画像のパス（base を含む）。語ページは /og/<id>.png、一覧は /og/index.png */
  ogImage?: string;
  /** 語の総数。ヘッダーに出す */
  count: number;
  /** 語ページでは見出しの左に索引への戻りを出す */
  back?: boolean;
}
const { lang, title, description, ogImage, count, back = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage && new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={localePath("en", "favicon.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="goi" />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "ja" ? "en_US" : "ja_JP"} />
    <Alternates />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <WebFonts
      hrefs={[
        "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@400;500;700&display=swap",
      ]}
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="shell">
      <header class="bar">
        <a class="bar__mark" href={localePath(lang)}>goi</a>
        {back && <a class="bar__back" href={localePath(lang)}>{t(lang, "index.back")}</a>}
        <span class="bar__count mono">{lang === "ja" ? `全${count}語` : `${count} words`}</span>
        <LangSwitch lang={lang} class="bar__lang" />
      </header>
      <slot />
      <footer class="foot">
        <p>{t(lang, "footer.note")}</p>
        <p class="mono"><a href="https://github.com/0-draft/goi">github.com/0-draft/goi</a></p>
      </footer>
    </div>
  </body>
</html>
