---
import { getCollection } from "astro:content";
import WebFonts from "../components/WebFonts.astro";
import "../styles/b.css";

interface Props {
  title: string;
  description: string;
  /** OGP 画像のパス（base を含む）。語ページは /og/<id>.png、一覧は /og/index.png */
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage && new URL(ogImage, Astro.site);

// 見出し書体は使う字だけを取り寄せる（&text= で字を絞る）
const HEADING_UI = "goi由来出典用例前の語次この語に触れている語";
const heads = (await getCollection("words")).filter((w) => !w.data.pending).map((w) => w.data.word);
const glyphs = [...new Set([...HEADING_UI, ...heads.join("")])].sort().join("");
const antique = `https://fonts.googleapis.com/css2?family=Shippori+Antique&display=swap&text=${encodeURIComponent(glyphs)}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F3F5F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141817" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="goi" />
    <meta property="og:locale" content="ja_JP" />
    {
      ogImageUrl && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <script is:inline>
      // 検索欄など JS が要る部品を、最初の描画から場所を取って出すため
      document.documentElement.classList.add("js");
    </script>
    <WebFonts hrefs={["https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=swap", antique]} />
  </head>
  <body>
    <slot />
  </body>
</html>
