---
import WebFonts from "../components/WebFonts.astro";
import "../styles/c.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#D6D7D3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#222423" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <WebFonts hrefs={["https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=swap"]} />
    <script is:inline>
      // 隣の駅から来たときだけ、進んだ向きをビュー遷移の種類として渡す
      document.documentElement.classList.add("js");
      addEventListener("pagereveal", (e) => {
        if (!e.viewTransition) return;
        try {
          if (sessionStorage.getItem("c-swiped")) {
            sessionStorage.removeItem("c-swiped");
            return;
          }
        } catch {}
        const from = window.navigation?.activation?.from?.url;
        if (!from) return;
        const path = new URL(from).pathname;
        const prev = document.querySelector('link[rel="prev"]');
        const next = document.querySelector('link[rel="next"]');
        if (next && new URL(next.href).pathname === path) e.viewTransition.types.add("backward");
        else if (prev && new URL(prev.href).pathname === path) e.viewTransition.types.add("forward");
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
